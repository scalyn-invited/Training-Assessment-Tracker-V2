{
  "info": {
    "name": "M1 Bernie client permissions - existing sandbox authentication",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Isolated synthetic databases only. Existing local sandbox signed delegation mechanism; NOT authentik/OIDC. Supply locally issued tokens. Capture staleToken before changing permissions and revokedToken before ending client membership. Synthetic records are intentionally absent from export responses."
  },
  "item": [
    {
      "name": "Permitted self summary",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "X-Client-Id",
            "value": "{{clientId}}"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/v1/me/training"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
