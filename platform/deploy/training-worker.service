[Unit]
Description=Training queue worker
After=network.target mariadb.service

[Service]
User=training
Group=training
WorkingDirectory=/srv/training/current/platform
ExecStart=/usr/bin/php artisan queue:work database --queue=ai_grading,notifications,extraction,integration,ai_generation --sleep=2 --tries=1 --timeout=120 --max-time=3600
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=150
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
