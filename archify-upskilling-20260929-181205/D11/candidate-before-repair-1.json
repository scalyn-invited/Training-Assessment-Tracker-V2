      "variant": "default",
      "classification": "Training evidence · scoped"
    },
    {
      "id": "definitions-to-calculate",
      "from": "definitions",
      "to": "calculate",
      "label": "Formula + target",
      "variant": "default",
      "classification": "Training evidence · scoped"
    },
    {
      "id": "calculate-to-snapshot",
      "from": "calculate",
      "to": "snapshot",
